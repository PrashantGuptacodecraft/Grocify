# Copy this file to server/.env and fill in your values.

# The Gmail address that SENDS the order emails.
GMAIL_USER=youraddress@gmail.com

# A Google "App Password" (NOT your normal Gmail password).
# Create it at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on your Google account)
GMAIL_APP_PASSWORD=your16charapppassword

# Where order notifications are delivered. Defaults to GMAIL_USER if omitted.
OWNER_EMAIL=youraddress@gmail.com

# Port for the backend API.
PORT=5000
